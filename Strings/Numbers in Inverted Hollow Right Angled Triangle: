N = int(input())

current_number = 1

for row in range(1, N + 1):
    each_row = ""
    # Total columns in the current row decrease as row increases
    total_cols = N - row + 1
    
    for col in range(1, total_cols + 1):
        # Check boundary condition (first row, first column, or last column of current row)
        if row == 1 or col == 1 or col == total_cols:
            each_row += str(current_number) + " "
        else:
            # Two spaces for hollow inner spots
            each_row += "  "
            
        # Increment number for every position in the grid
        current_number += 1

    print(each_row)
