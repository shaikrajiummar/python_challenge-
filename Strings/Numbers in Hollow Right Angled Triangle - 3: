S = int(input())
N = int(input())

current_number = S

for row in range(1, N + 1):
    each_row = ""
    for col in range(1, row + 1):
        # Check if the position is on any boundary of the triangle
        if row == 1 or row == N or col == 1 or col == row:
            each_row += str(current_number) + " "
            current_number += 1
        else:
            # Add two spaces for hollow inner spots
            each_row += "  "

    print(each_row)
