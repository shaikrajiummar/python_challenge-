S = int(input())
N = int(input())

current_number = S
https://github.com/shaikrajiummar/python_challenge-/tree/main/Strings
for row in range(1, N + 1):
    each_row = ""
    total_cols = N - row + 1
    
    # 1. Add leading spaces to right-align the inverted triangle
    leading_spaces = "  " * (row - 1)
    each_row += leading_spaces
    
    # 2. Print the numbers and inner hollow spaces
    for col in range(1, total_cols + 1):
        if row == 1 or col == 1 or col == total_cols:
            each_row += str(current_number) + " "
            current_number += 1
        else:
            each_row += "  "

    print(each_row)
