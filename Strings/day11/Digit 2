n = int(input())

for i in range(1, 2 * n):
    if i == 1 or i == n or i == 2 * n - 1:
        # Top, middle, and bottom rows: print N stars with spaces
        print("* " * n)
    elif i < n:
        # Upper section (between top and middle): stars aligned to the right
        print("  " * (n - 1) + "* ")
    else:
        # Lower section (between middle and bottom): star aligned to the left
        print("* ")
