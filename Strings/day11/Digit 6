n = int(input())

for i in range(1, 2 * n):
    if i == 1 or i == n or i == 2 * n - 1:
        # Top, middle, and bottom horizontal lines
        print("* " * n)
    elif i < n:
        # Upper vertical section: left star only
        print("* ")
    else:
        # Lower vertical section: left and right stars with spaces in between
        print("* " + "  " * (n - 2) + "* ")
