n = int(input())

for i in range(1, 2 * n + 2):
    if i == 1 or i == n + 1 or i == 2 * n + 1:
        # Top, middle, and bottom rows: full line of N stars with spaces
        print("* " * n)
    else:
        # Hollow rows: left star, spaces in between, right star
        print("* " + "  " * (n - 2) + "* ")
