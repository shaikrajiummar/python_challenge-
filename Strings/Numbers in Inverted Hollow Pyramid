N = int(input())
S = int(input())

for row in range(1, N + 1):
    # 1. Leading spaces for inverted pyramid alignment
    leading_spaces = " " * (row - 1)
    
    total_cols = N - row + 1
    row_content = ""
    
    if row == 1:
        # First row prints numbers from S to S + N - 1
        for i in range(total_cols):
            row_content += str(S + i) + " "
    elif row == N:
        # Last row prints just S
        row_content += str(S) + " "
    else:
        # First number on left boundary is S
        left_val = S
        
        # Right boundary value decreases as row increases
        # Row 2 gets S + N - 2, Row 3 gets S + N - 3, etc.
        right_val = S + total_cols - 1
        
        # Hollow inner spaces: each cell takes 2 character widths
        inner_spaces = " " * (2 * (total_cols - 2))
        
        row_content = str(left_val) + " " + inner_spaces + str(right_val) + " "

    print(leading_spaces + row_content)
