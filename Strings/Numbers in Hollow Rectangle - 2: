M = int(input())
N = int(input())

current_number = 1

for row in range(1, M + 1):
    each_row = ""
    for col in range(1, N + 1):
        if row == 1 or row == M or col == 1 or col == N:
            each_row += str(current_number) + " "
        else:
            # Add two spaces for the empty hollow spots
            each_row += "  "
        
        # Increment number for every position in the M x N grid
        current_number += 1

    print(each_row)
