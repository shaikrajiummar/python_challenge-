N = int(input())

# Total numbers across the entire triangle grid sequence
current_number = N * (N + 1) // 2

for row in range(1, N + 1):
    each_row = ""
    total_cols = N - row + 1
    
    for col in range(1, total_cols + 1):
        if row == 1 or col == 1 or col == total_cols:
            each_row += str(current_number) + " "
        else:
            # Two spaces for inner hollow spots
            each_row += "  "
            
        # Decrement number for EVERY position in the grid
        current_number -= 1

    print(each_row)
