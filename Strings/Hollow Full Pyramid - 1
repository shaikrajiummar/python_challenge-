N = int(input())

for row in range(1, N + 1):
    # 1. Leading spaces for centering the pyramid
    leading_spaces = " " * (N - row)
    
    # 2. Logic for pyramid content
    if row == 1:
        content = "* "
    elif row == N:
        # Last row contains N stars separated by spaces
        content = "* " * N
    else:
        # Middle rows have a star on left boundary, spaces, and star on right boundary
        inner_spaces = " " * (2 * (row - 2))
        content = "* " + inner_spaces + "* "

    print(leading_spaces + content)
