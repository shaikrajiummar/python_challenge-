N = int(input())

# Calculate the total count of numbers in the triangle: N * (N + 1) // 2
current_number = N * (N + 1) // 2

for row in range(1, N + 1):
    each_row = ""
    total_cols = N - row + 1
    
    for col in range(1, total_cols + 1):
        if row == 1 or col == 1 or col == total_cols:
            each_row += str(current_number) + " "
            current_number -= 1
        else:
            each_row += "  "

    print(each_row)
