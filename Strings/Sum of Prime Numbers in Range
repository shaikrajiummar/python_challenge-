M = int(input())
N = int(input())

prime_sum = 0

for num in range(M, N + 1):
    # Prime numbers must be greater than 1
    if num > 1:
        is_prime = True
        for i in range(2, int(num ** 0.5) + 1):
            if num % i == 0:
                is_prime = False
                break
        
        if is_prime:
            prime_sum += num

print(prime_sum)
